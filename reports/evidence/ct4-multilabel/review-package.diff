+@pytest.mark.parametrize('value', [None,[],{}, {'version':'wrong'},'not-json'])
+def test_missing_or_invalid_rules_are_readiness_errors(tmp_path,value):
+    Service,create_app=components()
+    path=tmp_path/'rules.json'
